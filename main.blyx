use std::cli;
use std::text;
use vendor::csvpair;
use residualwatch;

fn main() {
    let args = cli_args();
    if args_len(args) == 0 { csv_fail("Usage: residualwatch FILE --reference N [--allowance K] [--limit H] [--min-scale S]"); }
    let path = args_at(args, 0);
    if path == "--version" { println!("residualwatch 0.1.0"); return; }
    if path == "--help" {
        println!("residualwatch FILE --reference N [--allowance K] [--limit H] [--min-scale S]");
        println!("CSV header: actual,predicted. Exit 0 for steady, 1 for an alert, 2 for invalid input, 4 for I/O.");
        return;
    }
    let mut nref = 0.0;
    let mut allowance = 0.5;
    let mut limit = 5.0;
    let mut floor = 0.0;
    let mut i = 1;
    while i < args_len(args) {
        let key = args_at(args, i);
        if key == "--reference" { nref = csv_option(args, i); }
        else if key == "--allowance" { allowance = csv_option(args, i); }
        else if key == "--limit" { limit = csv_option(args, i); }
        else if key == "--min-scale" { floor = csv_option(args, i); }
        else { csv_fail(text_concat("Unknown option: ", key)); }
        i += 2;
    }
    if nref < 2.0 || nref > 9007199254740991.0 || nref % 1.0 != 0.0 { csv_fail("--reference must be a whole number of at least two."); }
    if allowance < 0.0 || limit <= 0.0 || floor < 0.0 { csv_fail("Allowance and scale floor must be nonnegative. The limit must be positive."); }
    let lines = csv_open(path, "actual,predicted");
    let mut history = rw_training();
    let mut reference: vector = [];
    let mut state = rw_monitor();
    let mut seen = 0.0;
    let mut first = 0.0;
    let mut direction = 0.0;
    let mut up = 0;
    let mut down = 0;
    i = 1;
    while i < args_len(lines) {
        let row = csv_pair(args_at(lines, i), i + 1);
        i += 1;
        if len(row) == 0 { continue; }
        seen += 1.0;
        if seen <= nref {
            history = rw_train(history, at(row, 0), at(row, 1));
            if len(history) == 0 { csv_error(i, "reference summary exceeds numeric range"); }
            if seen == nref {
                reference = rw_freeze(history, floor);
                if len(reference) == 0 { csv_fail("Reference residuals need variation or a positive --min-scale."); }
            }
        } else {
            state = rw_step(state, reference, at(row, 0), at(row, 1), allowance, limit);
            if len(state) == 0 { csv_error(i, "monitor calculation exceeds numeric range"); }
            let signal = at(state, 2);
            if signal != 0.0 && first == 0.0 { first = seen; direction = signal; }
            if signal == 1.0 { up += 1; }
            if signal == -1.0 { down += 1; }
        }
    }
    if seen <= nref { csv_fail("Supply the reference rows and at least one later observation."); }
    print!("{\"reference_rows\":"); print!(nref);
    print!(",\"monitored_rows\":"); print!(seen - nref);
    print!(",\"center\":"); print!(at(reference, 1));
    print!(",\"scale\":"); print!(at(reference, 2));
    print!(",\"up_alerts\":"); print!(up);
    print!(",\"down_alerts\":"); print!(down);
    print!(",\"first_alert_row\":"); if first == 0.0 { print!("null"); } else { print!(first); }
    print!(",\"first_direction\":"); print!(direction);
    print!(",\"alert\":"); print!(first != 0.0); println!("}");
    if first != 0.0 { process_exit(1); }
}
